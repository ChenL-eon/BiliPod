<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 深色模式：炭灰底，不是纯黑 -->
    <style name="Theme.BiliPod" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF131616</item>
        <item name="android:statusBarColor">#FF131616</item>
        <item name="android:navigationBarColor">#FF131616</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- API 27 才有这个属性；minSdk 26 的老设备上系统直接忽略，行为与不加一致 -->
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
</resources>
